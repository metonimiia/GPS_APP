<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E0E"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">


    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="КАЛЬКУЛЯТОР"
        android:textColor="@color/white"
        android:textSize="26dp"
        android:gravity="center"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:padding="20dp">


        <TextView
            android:id="@+id/resultsTV"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:lines="1"
            android:maxLines="1"
            android:text=""
            android:textAlignment="textEnd"
            android:textColor="@color/white"
            android:textSize="40sp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/workingTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="2"
            android:maxLines="2"
            android:text=""
            android:textAlignment="textEnd"
            android:textColor="@color/white"
            android:textSize="35sp"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resultsTV" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <Button
            style="@style/buttonOperator"
            android:onClick="clearAction"
            android:tag="C"
            android:text="C" />

        <Button
            style="@style/buttonOperator"
            android:onClick="backspaceAction"
            android:tag="←"
            android:text="←" />

        <Button
            style="@style/buttonOperator"
            android:onClick="operationAction"
            android:tag="÷"
            android:text="÷" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="7"
            android:text="7" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="8"
            android:text="8" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="9"
            android:text="9" />

        <Button
            style="@style/buttonOperator"
            android:onClick="operationAction"
            android:tag="*"
            android:text="x" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="4"
            android:text="4" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="5"
            android:text="5" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="6"
            android:text="6" />

        <Button
            style="@style/buttonOperator"
            android:onClick="operationAction"
            android:tag="-"
            android:text="-" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="1"
            android:text="1" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="2"
            android:text="2" />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="3"
            android:text="3" />

        <Button
            style="@style/buttonOperator"
            android:onClick="operationAction"
            android:tag="+"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="."
            android:text="." />

        <Button
            style="@style/buttonNumber"
            android:onClick="numberAction"
            android:tag="0"
            android:text="0" />

        <Button
            style="@style/buttonRezult"
            android:onClick="rezultAction"
            android:tag="="
            android:text="=" />
    </LinearLayout>

</LinearLayout>